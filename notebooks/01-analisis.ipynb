{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Análisis Exploratorio: Titanic Dataset\n",
    "\n",
    "## Objetivo\n",
    "Analizar el dataset del Titanic para identificar características asociadas con la supervivencia,\n",
    "realizando el necesario preprocesamiento y limpieza de datos.\n",
    "\n",
    "## Dataset\n",
    "Archivo: `data/dataset.csv`\n",
    "- 891 pasajeros del RMS Titanic\n",
    "- 12 variables incluyendo datos demográficos, clase y información de supervivencia\n",
    "- Fuente: Kaggle Titanic Competition\n",
    "\n",
    "## Exploración Inicial\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {"tags": ["imports"]},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Cargar dataset\n",
    "df = pd.read_csv('data/dataset.csv')\n",
    "\n",
    "# Mostrar primeras filas\n",
    "df.head()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {"tags": ["exploration"]},
   "outputs": [],
   "source": [
    "print('=== INFORMACIÓN DEL DATASET ===')\n",
    f"Número de pasajeros: {len(df)}\n",
    f"Número de columnas: {len(df.columns)}\n",
    "\n",
    "print('Variables disponibles:')\n",
    "for col in df.columns:\n",
    "    print(f'  - {col}')\n",
    "\n",
    "print('\\nTipos de datos:')\n",
    "for col, dtype in df.dtypes.items():\n",
    "    print(f'  {col}: {dtype}')\n",
    "\n",
    "print('\\nValores faltantes:')\n",
    "missing = df.isnull().sum()\n",
    "for col, count in missing.items():\n",
    "    if count > 0:\n",
    "        print(f'  {col}: {count} valores faltantes')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {"tags": ["preprocessing"]},
   "outputs": [],
   "source": [
    "# Tratar valores faltantes en Age\n",
    "df['Age'].fillna(df['Age'].median(), inplace=True)\n",
    "\n",
    "# Tratar valores faltantes en Embarked\n",
    "df['Embarked'].fillna(df['Embarked'].mode()[0], inplace=True)\n",
    "\n",
    "# Tratar valores faltantes en Cabin (crear categoría 'Desconocido')\n",
    "df['Cabin'] = df['Cabin'].notna().map({'True': 'Tiene cabineta', 'False': 'Sin cabineta'})\n",
    "\n",
    "# Crear variable FamilySize\n",
    "df['FamilySize'] = df['SibSp'] + df['Parch'] + 1\n",
    "\n",
    "# Crear categorías de edad\n",
    "def categorizar_edad(age):\n",
    "    if age < 16:\n",
    "        return 'Niño'\n",
    "    elif age < 30:\n",
    "        return 'Joven'\n",
    "    elif age < 60:\n",
    "        return 'Adulto'\n",
    "    else:\n",
    "        return 'Adulto mayor'\n",
    "\n",
    "df['EdadCategoria'] = df['Age'].apply(categorizar_edad)\n",
    "\n",
    "# Crear variable Titulo a partir del nombre\n",
    "df['Titulo'] = df['Name'].str.extract(' ([A-Za-z]+)\\.', expand=False)\n",
    "titulos_comunes = ['Mr', 'Mrs', 'Miss', 'Master']\n",
    "df['Titulo'] = df['Titulo'].apply(lambda x: x if x in titulos_comunes else 'Other')\n",
    "\n",
    "print('✓ Preprocesamiento completado')\n",
    f"Filas después de limpieza: {len(df)}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {"tags": ["analisis"]},
   "outputs": [],
   "source": [
    "# Análisis: Supervivencia por género\n",
    "sns.countplot(data=df, x='Sex', hue='Survived')\n",
    "plt.title('Supervivencia por Género')\n",
    "plt.savefig('outputs/resultados/supervivencia_genero.png')\n",
    "plt.show()\n",
    "\n",
    "# Análisis: Supervivencia por clase\n",
    "sns.countplot(data=df, x='Pclass', hue='Survived')\n",
    "plt.title('Supervivencia por Clase')\n",
    "plt.savefig('outputs/resultados/supervivencia_clase.png')\n",
    "plt.show()\n",
    "\n",
    "# Análisis: Supervivencia por clase de edad\n",
    "sns.countplot(data=df, x='EdadCategoria', hue='Survived')\n",
    "plt.title('Supervivencia por Categoría de Edad')\n",
    "plt.savefig('outputs/resultados/supervivencia_edad.png')\n",
    "plt.show()\n",
    "\n",
    "# Análisis: Supervivencia por familia\n",
    "sns.countplot(data=df, x='FamilySize', hue='Survived')\n",
    "plt.title('Supervivencia por Tamaño de Familia')\n",
    "plt.savefig('outputs/resultados/supervivencia_familia.png')\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {"tags": ["conclusions"]},
   "outputs": [],
   "source": [
    "# Generar reporte de conclusiones\n",
    "supervivencia_genero = df.groupby('Sex')['Survived'].mean().reset_index()\n",
    "supervivencia_genero.columns = ['Sexo', 'Tasa_supervivencia']\n",
    "\n",
    "supervivencia_clase = df.groupby('Pclass')['Survived'].mean().reset_index()\n",
    "supervivencia_clase.columns = ['Clase', 'Tasa_supervivencia']\n",
    "\n",
    "print('=== CONCLUSIÓN PRINCIPAL ===')\n",
    "print(f'La tasa de supervivencia general fue de {df[\"Survived\"].mean()*100:.1f}%')\n",
    "\n",
    "print('\\nTasa de supervivencia por género:')\n",
    "print(supervivencia_genero.to_string(index=False))\n",
    "\n",
    "print('\\nTasa de supervivencia por clase:')\n",
    "print(supervivencia_clase.to_string(index=False))\n",
    "\n",
    "# Guardar reporte\n",
    "reporte = {\n",
    "    'total_pasajeros': len(df),\n",
    "    'tasa_supervivencia_general': float(df['Survived'].mean()),\n",
    "    'supervivencia_por_genero': supervivencia_genero.to_dict(),\n",
    "    'supervivencia_por_clase': supervivencia_clase.to_dict()\n",
    "}\n",
    "\n",
    "with open('../preprocesamiento.json', 'w') as f:\n",
    "    json.dump(reporte, f, indent=2, default=str)\n",
    "\n",
    "print('\\n✓ Reporte guardado en preprocesamiento.json')"
   ]
  }
 ],
